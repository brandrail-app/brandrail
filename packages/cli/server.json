{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "au.com.brandrail/brandrail",
  "title": "Brandrail",
  "description": "Design system guardrails for AI coding tools: tokens, components and a brand checker. Runs locally.",
  "websiteUrl": "https://www.brandrail.com.au/docs/connect",
  "icons": [
    {
      "src": "https://www.brandrail.com.au/logo/brandrail-mark.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://www.brandrail.com.au/logo/brandrail-mark-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/brandrail-app/brandrail",
    "source": "github",
    "subfolder": "packages/cli"
  },
  "version": "0.10.3",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "brandrail",
      "version": "0.10.3",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "environmentVariables": [
        {
          "name": "BRANDRAIL_KEY",
          "description": "Optional. API key from Brandrail Dashboard > Connect, to load your organisation's Brand Kit. Without it, the repo's brandrail.config.json or starter tokens are used.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
